{
  // The game's Worker. Top level: local dev only (`wrangler dev`, no remote). A named env deploys
  // as its own Worker `<name>-<env>`; bindings, vars and secrets.required are not inherited, so each
  // env declares all of them. Every wrangler command carries --env; never a bare `wrangler deploy`.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nearling",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,

  // The web client, built by plain Vite into web/dist, served by this Worker: one origin with the API.
  // /api/* and /health reach the Worker first; every other path is an asset or index.html.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },

  // Workers Logs without the per-request invocation record (ADR-020).
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },

  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "vars": {
    "ENVIRONMENT": "local",
    "NEAR_NETWORK": "testnet"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "nearling-db-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations/db" },
    { "binding": "EVENTS", "database_name": "nearling-events-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations/events" }
  ],

  "durable_objects": { "bindings": [{ "name": "PET_DESK", "class_name": "PetDesk" }, { "name": "LIMITER", "class_name": "Limiter" }, { "name": "GUEST_VIEW", "class_name": "GuestView" }, { "name": "SERVER_KEY", "class_name": "ServerKey" }, { "name": "SOURCE_CACHE", "class_name": "SourceCache" }, { "name": "SHOWCASE", "class_name": "Showcase" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PetDesk", "Limiter", "GuestView", "ServerKey"] }, { "tag": "v2", "new_sqlite_classes": ["SourceCache"] }, { "tag": "v3", "new_sqlite_classes": ["Showcase"] }],

  // Dynamic Workers (ADR-025): the isolates a skill's code runs in. Open beta, Workers Paid.
  "worker_loaders": [{ "binding": "LOADER" }],

  "env": {
    "dev": {
      "workers_dev": true,
      "preview_urls": false,
      // Until R1 mainnet the public domains show the working testnet game; at R1 they move to prod.
      "routes": [
        { "pattern": "nearling.xyz", "custom_domain": true },
        { "pattern": "api.nearling.xyz", "custom_domain": true }
      ],
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/health"]
      },
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false }
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "ENVIRONMENT": "dev",
        // Dev only: the first name a Privy test account signs in with (it has no Google name), for the scripted
        // sign-in of the dev build. Prod has no such var: its feeders are named by Google alone.
        "DEV_TEST_NAME": "Maya",
        "NEAR_NETWORK": "testnet",
        "NEAR_RPC_URL": "https://test.rpc.fastnear.com",
        "CONTRACT_ID": "nearling-dev.testnet",
        "SERVER_ACCOUNT_ID": "nearling-dev-server.testnet",
        "GAS_ACCOUNT_ID": "nearling-dev-gas.testnet",
        "TREASURY_ACCOUNT_ID": "nearling-dev-treasury.testnet",
        "PRIVY_APP_ID": "cmvtjc1q100s30gl22hfxq7ap",
        "PRIVY_JWKS_URL": "https://auth.privy.io/api/v1/apps/cmvtjc1q100s30gl22hfxq7ap/jwks.json",
        // The canonical NEAR AI Cloud model id (ADR-005 > Init check), never an alias. The rates are USD per
        // million tokens (volatile); NEAR_USD_RATE is the user's, changed by a config edit and a deploy.
        "MODEL_ID": "Qwen/Qwen3.8-27B",
        "PRICE_IN_USD_PER_MTOK": "0.04",
        "PRICE_OUT_USD_PER_MTOK": "1.35",
        "NEAR_USD_RATE": "4.59",
        // What one web search costs the project at NEAR AI, USD (volatile, re-read before R1 like the token rates).
        "SEARCH_USD_PER_CALL": "0.005"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "nearling-db-dev", "database_id": "6bd873d3-77b9-401f-a548-ac7dc2ca8237", "migrations_dir": "migrations/db" },
        { "binding": "EVENTS", "database_name": "nearling-events-dev", "database_id": "9334227d-ad92-4d14-8051-b8452171fcae", "migrations_dir": "migrations/events" }
      ],
      // Durable Objects (ADR-021): PetDesk spends one pet's thoughts one at a time, Limiter and GuestView
      // hold memory-only counts and copies, Showcase persists one public copy, ServerKey queues transactions.
      "durable_objects": { "bindings": [{ "name": "PET_DESK", "class_name": "PetDesk" }, { "name": "LIMITER", "class_name": "Limiter" }, { "name": "GUEST_VIEW", "class_name": "GuestView" }, { "name": "SERVER_KEY", "class_name": "ServerKey" }, { "name": "SOURCE_CACHE", "class_name": "SourceCache" }, { "name": "SHOWCASE", "class_name": "Showcase" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PetDesk", "Limiter", "GuestView", "ServerKey"] }, { "tag": "v2", "new_sqlite_classes": ["SourceCache"] }, { "tag": "v3", "new_sqlite_classes": ["Showcase"] }],
      "worker_loaders": [{ "binding": "LOADER" }],
      "triggers": { "crons": ["* * * * *"] },
      // Names that exist on the Worker `nearling-dev`, RIDDLE_LIST (add-daily-ritual) and SKILL_KEY
      // (add-pet-work: base64 of 32 random bytes): the user types them before this change's dev deploy.
      "secrets": { "required": ["NEARAI_API_KEY", "NEAR_GAS_ACCOUNT_KEY", "NEAR_SERVER_KEY", "INSULT_LIST", "RIDDLE_LIST", "SKILL_KEY", "BASE_GAS_WALLET_KEY", "SOLANA_GAS_WALLET_KEY"] }
    },

    // prod: names only. Its ids, accounts and Privy app are the main session's, at R1 mainnet; the
    // zero ids make a deploy fail instead of provisioning a database. Nobody runs --env prod before R1.
    "prod": {
      // The account's workers.dev subdomain carries a personal name: prod stays off it. The project's own
      // domains (nearling.xyz, api.nearling.xyz) serve dev until R1 mainnet and move here then.
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/health"]
      },
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false }
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "ENVIRONMENT": "prod",
        "NEAR_NETWORK": "mainnet",
        "NEAR_RPC_URL": "",
        "CONTRACT_ID": "",
        "SERVER_ACCOUNT_ID": "",
        "GAS_ACCOUNT_ID": "",
        "TREASURY_ACCOUNT_ID": "",
        "PRIVY_APP_ID": "cmwertv2m00kr0il85l73cnf0",
        "PRIVY_JWKS_URL": "https://auth.privy.io/api/v1/apps/cmwertv2m00kr0il85l73cnf0/jwks.json",
        "MODEL_ID": "Qwen/Qwen3.8-27B",
        "PRICE_IN_USD_PER_MTOK": "0.04",
        "PRICE_OUT_USD_PER_MTOK": "1.35",
        "NEAR_USD_RATE": "",
        "SEARCH_USD_PER_CALL": "0.005"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "nearling-db-prod", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations/db" },
        { "binding": "EVENTS", "database_name": "nearling-events-prod", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations/events" }
      ],
      "durable_objects": { "bindings": [{ "name": "PET_DESK", "class_name": "PetDesk" }, { "name": "LIMITER", "class_name": "Limiter" }, { "name": "GUEST_VIEW", "class_name": "GuestView" }, { "name": "SERVER_KEY", "class_name": "ServerKey" }, { "name": "SOURCE_CACHE", "class_name": "SourceCache" }, { "name": "SHOWCASE", "class_name": "Showcase" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PetDesk", "Limiter", "GuestView", "ServerKey"] }, { "tag": "v2", "new_sqlite_classes": ["SourceCache"] }, { "tag": "v3", "new_sqlite_classes": ["Showcase"] }],
      "worker_loaders": [{ "binding": "LOADER" }],
      "triggers": { "crons": ["* * * * *"] },
      "secrets": { "required": ["NEARAI_API_KEY", "NEAR_GAS_ACCOUNT_KEY", "NEAR_SERVER_KEY", "INSULT_LIST", "RIDDLE_LIST", "SKILL_KEY", "BASE_GAS_WALLET_KEY", "SOLANA_GAS_WALLET_KEY"] }
    }
  }
}
